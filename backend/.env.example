# Optional OpenAI-compatible API. Without these values, the app uses clearly labeled demo mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Supabase project. If omitted, local SQLite is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local SQLite location
DATABASE_PATH=./travel_planner.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
